<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.KarooGarage">

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EntityPickerActivity"
            android:exported="false"
            android:label="@string/picker_title" />

        <!-- Exported so a file manager can open a .kgcfg with it. VIEW only: the code
             re-checks action, scheme and file type, bounds the read, and asks before
             replacing anything (ADR-0002). No SEND, no BROWSABLE. -->
        <activity
            android:name=".ImportConfigActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.KarooGarage.Translucent"
            android:noHistory="true"
            android:excludeFromRecents="true">
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.kgcfg" />
                <data android:pathPattern=".*\\..*\\.kgcfg" />
                <data android:pathPattern=".*\\..*\\..*\\.kgcfg" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.kgcfg" />
            </intent-filter>
        </activity>

        <service
            android:name=".GarageExtension"
            android:exported="true">
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>

    </application>
</manifest>
